# Copy to .env.local (development) or set on the server. Never commit real values.
# Phase 1 (prototype) needs none of these. They are listed so the shape is fixed early.

# Public site URL (used in emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2) — the service role key is server-only, never expose it to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Stream (Phase 3) — signing key for short-lived playback tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=

# Stripe (card payments; bank transfer works without it) — test-mode keys first. See docs/STRIPE_SETUP.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend, optional). Without a key nothing is sent and the site works the same.
# Free plan without a verified domain: Resend only delivers to your own account email (OK for ADMIN_NOTIFY_EMAIL).
RESEND_API_KEY=
EMAIL_FROM="GAIA LEARNING <onboarding@resend.dev>"
# Where to send "new bank-transfer order" and "new inquiry" alerts
ADMIN_NOTIFY_EMAIL=
