# Copy to .env.local (development) or set on the server. Never commit real values.
# Phase 1 (prototype) needs none of these. They are listed so the shape is fixed early.

# Public site URL (used in emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2) — the service role key is server-only, never expose it to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Stream (Phase 3) — signing key for short-lived playback tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=

# Stripe (Phase 4) — start with test-mode keys (sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — invitations, verification, 領収書
RESEND_API_KEY=
EMAIL_FROM="GAIA LEARNING <no-reply@example.com>"
